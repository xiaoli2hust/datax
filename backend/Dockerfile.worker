FROM maven:3.9.11-eclipse-temurin-8@sha256:e3c149f44c95b0e9dd131862b3df67b3f061f7f6f3898a87b170564b3a943611 AS datax-build

WORKDIR /src
COPY third_party/alibaba-datax/ ./
COPY runtime/patches/0001-reproducible-safe-runtime.patch /tmp/datax-runtime.patch
COPY runtime/upstream-files.sha256 /tmp/datax-upstream-files.sha256

RUN echo "65230e3a9b31e861b38a58d12d758eed4d8b539351706d0ddb241b851c899b3b  /tmp/datax-upstream-files.sha256" \
        | sha256sum --check --strict --status \
    && test "$(find . -type f | wc -l)" -eq 1346 \
    && test -z "$(find . -type l -print -quit)" \
    && sha256sum --check --strict --status /tmp/datax-upstream-files.sha256 \
    && git apply --check /tmp/datax-runtime.patch \
    && git apply /tmp/datax-runtime.patch \
    && mvn --batch-mode --no-transfer-progress \
        -DskipTests \
        -Dmaven.test.skip=true \
        -Dmaven.javadoc.skip=true \
        -Dcheckstyle.skip=true \
        -pl core,transformer,mysqlreader,mysqlwriter,postgresqlreader,postgresqlwriter,streamreader,streamwriter \
        -am package \
    && echo "0353648eaa1c91e0f4020c959abf756bc866ffd583df22ae6b6f6e0cbd43eb44  mysqlreader/target/datax-datax/plugin/reader/mysqlreader/libs/mysql-connector-j-9.7.0.jar" \
        | sha256sum --check --strict --status \
    && echo "0353648eaa1c91e0f4020c959abf756bc866ffd583df22ae6b6f6e0cbd43eb44  mysqlwriter/target/datax-datax/plugin/writer/mysqlwriter/libs/mysql-connector-j-9.7.0.jar" \
        | sha256sum --check --strict --status \
    && mkdir -p /runtime/datax \
    && cp -a core/target/datax-datax/. /runtime/datax/ \
    && cp -a transformer/target/datax-datax/. /runtime/datax/ \
    && cp -a mysqlreader/target/datax-datax/. /runtime/datax/ \
    && cp -a mysqlwriter/target/datax-datax/. /runtime/datax/ \
    && cp -a postgresqlreader/target/datax-datax/. /runtime/datax/ \
    && cp -a postgresqlwriter/target/datax-datax/. /runtime/datax/ \
    && cp -a streamreader/target/datax-datax/. /runtime/datax/ \
    && cp -a streamwriter/target/datax-datax/. /runtime/datax/

FROM python:3.12.13-slim-trixie@sha256:57cd7c3a7a273101a6485ba99423ee568157882804b1124b4dd04266317710de

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    JAVA_HOME=/opt/java/openjdk \
    PATH=/opt/java/openjdk/bin:/usr/local/bin:/usr/bin:/bin

RUN /usr/sbin/groupadd --system --gid 10001 dataxstudio \
    && /usr/sbin/useradd --system --uid 10001 --gid dataxstudio --home /app dataxstudio

WORKDIR /app
COPY backend/pyproject.toml backend/alembic.ini \
    backend/requirements.lock backend/build-requirements.lock ./
COPY backend/migrations ./migrations
COPY backend/src ./src
RUN python -m pip install --require-hashes -r build-requirements.lock \
    && python -m pip install --require-hashes -r requirements.lock \
    && python -m pip install --no-build-isolation --no-deps . \
    && python -m pip uninstall --yes pip setuptools wheel \
    && find /usr/local/lib/python3.12/ensurepip -depth -delete \
    && python -c 'import importlib.util; missing = ("pip", "setuptools", "wheel"); assert all(importlib.util.find_spec(name) is None for name in missing)' \
    && test ! -e /usr/local/bin/pip \
    && test ! -e /usr/local/bin/pip3 \
    && test ! -e /usr/local/bin/wheel

COPY --from=datax-build /opt/java/openjdk /opt/java/openjdk
COPY --from=datax-build /runtime/datax /opt/datax/datax
COPY runtime/config/logback.xml /opt/datax/datax/conf/logback.xml
COPY runtime/config/job.json /opt/datax/datax/job/job.json
COPY runtime/oracle/verification_oracle.py /opt/datax/oracle/verification_oracle.py
COPY third_party/alibaba-datax/license.txt /opt/datax/licenses/DataX-license-notice.txt
COPY third_party/alibaba-datax/NOTICE /opt/datax/licenses/DataX-NOTICE
COPY third_party/licenses/Apache-2.0.txt /opt/datax/licenses/Apache-2.0.txt
COPY third_party/licenses/LGPL-2.1-or-later.txt /opt/datax/licenses/LGPL-2.1-or-later.txt
COPY third_party/licenses/MySQL-Connector-J-9.7.0-LICENSE.txt /opt/datax/licenses/MySQL-Connector-J-9.7.0-LICENSE.txt

RUN mkdir -p /var/lib/datax-studio/logs /var/lib/datax-studio/runs \
    && python -m datax_studio.runtime_build \
        --root /opt/datax \
        --java /opt/java/openjdk/bin/java \
    && find /opt/datax -type d -exec chmod 0555 {} + \
    && find /opt/datax -type f -exec chmod 0444 {} + \
    && chown -R dataxstudio:dataxstudio \
        /app \
        /var/lib/datax-studio/logs \
        /var/lib/datax-studio/runs

USER dataxstudio

CMD ["python", "-m", "datax_studio.worker.main"]

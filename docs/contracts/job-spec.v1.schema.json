{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datax-enterprise-studio.local/schemas/job-spec.v1.schema.json",
  "title": "DataX Enterprise Studio JobSpec V1",
  "description": "V1 离线批同步任务草稿与发布版本的规范格式。结构上不提供 SQL、调度、Transformer 或自定义插件入口。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source",
    "target",
    "selection_mode",
    "mappings",
    "write_policy",
    "execution_policy"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "source": {
      "$ref": "#/$defs/sourceEndpoint"
    },
    "target": {
      "$ref": "#/$defs/targetEndpoint"
    },
    "selection_mode": {
      "type": "string",
      "enum": [
        "ALL_COLUMNS",
        "SELECTED_COLUMNS"
      ]
    },
    "mappings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2048,
      "items": {
        "$ref": "#/$defs/columnMapping"
      }
    },
    "write_policy": {
      "$ref": "#/$defs/writePolicy"
    },
    "execution_policy": {
      "$ref": "#/$defs/executionPolicy"
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001F\\u007F/\\\\]+$"
    },
    "tableRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_name",
        "table_name"
      ],
      "properties": {
        "schema_name": {
          "$ref": "#/$defs/identifier"
        },
        "table_name": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "sourceEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "datasource_id",
        "plugin_name",
        "table"
      ],
      "properties": {
        "datasource_id": {
          "$ref": "#/$defs/uuid"
        },
        "plugin_name": {
          "type": "string",
          "enum": [
            "mysqlreader",
            "postgresqlreader"
          ]
        },
        "table": {
          "$ref": "#/$defs/tableRef"
        }
      }
    },
    "targetEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "datasource_id",
        "plugin_name",
        "table"
      ],
      "properties": {
        "datasource_id": {
          "$ref": "#/$defs/uuid"
        },
        "plugin_name": {
          "type": "string",
          "enum": [
            "mysqlwriter",
            "postgresqlwriter"
          ]
        },
        "table": {
          "$ref": "#/$defs/tableRef"
        }
      }
    },
    "columnMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_column",
        "source_ordinal",
        "source_type",
        "source_nullable",
        "target_column",
        "target_ordinal",
        "target_type",
        "target_nullable",
        "compatibility"
      ],
      "properties": {
        "source_column": {
          "$ref": "#/$defs/identifier"
        },
        "source_ordinal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "source_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "source_nullable": {
          "type": "boolean"
        },
        "target_column": {
          "$ref": "#/$defs/identifier"
        },
        "target_ordinal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "target_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "target_nullable": {
          "type": "boolean"
        },
        "compatibility": {
          "type": "string",
          "enum": [
            "EXACT",
            "WIDENING"
          ]
        }
      }
    },
    "writePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "target_table_must_exist"
      ],
      "properties": {
        "mode": {
          "const": "INSERT"
        },
        "target_table_must_exist": {
          "const": true
        }
      }
    },
    "executionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "timeout_seconds",
        "dirty_data_limit"
      ],
      "properties": {
        "channel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16,
          "default": 1
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 604800,
          "default": 3600
        },
        "dirty_data_limit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "record_count",
            "percentage"
          ],
          "properties": {
            "record_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000,
              "default": 0
            },
            "percentage": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "multipleOf": 0.000001,
              "default": 0
            }
          }
        }
      }
    }
  },
  "examples": [
    {
      "schema_version": "1.0",
      "source": {
        "datasource_id": "11111111-1111-4111-8111-111111111111",
        "plugin_name": "mysqlreader",
        "table": {
          "schema_name": "sales",
          "table_name": "orders"
        }
      },
      "target": {
        "datasource_id": "22222222-2222-4222-8222-222222222222",
        "plugin_name": "postgresqlwriter",
        "table": {
          "schema_name": "public",
          "table_name": "orders_copy"
        }
      },
      "selection_mode": "SELECTED_COLUMNS",
      "mappings": [
        {
          "source_column": "id",
          "source_ordinal": 1,
          "source_type": "bigint",
          "source_nullable": false,
          "target_column": "id",
          "target_ordinal": 1,
          "target_type": "bigint",
          "target_nullable": false,
          "compatibility": "EXACT"
        },
        {
          "source_column": "amount",
          "source_ordinal": 2,
          "source_type": "decimal(18,2)",
          "source_nullable": false,
          "target_column": "amount",
          "target_ordinal": 2,
          "target_type": "numeric(18,2)",
          "target_nullable": false,
          "compatibility": "EXACT"
        }
      ],
      "write_policy": {
        "mode": "INSERT",
        "target_table_must_exist": true
      },
      "execution_policy": {
        "channel": 1,
        "timeout_seconds": 3600,
        "dirty_data_limit": {
          "record_count": 0,
          "percentage": 0
        }
      }
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datax-enterprise-studio.local/schemas/audit-event.v1.schema.json",
  "title": "DataX Enterprise Studio Audit Event V1",
  "description": "追加式安全审计事件。只记录稳定标识、哈希和脱敏元数据，不允许记录密码、Token、连接串或完整 DataX 配置。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "organization_id",
    "sequence",
    "project_id",
    "occurred_at",
    "action",
    "actor",
    "target",
    "request",
    "outcome",
    "reason_code",
    "changes",
    "metadata",
    "integrity"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "event_id": {
      "$ref": "#/$defs/uuid"
    },
    "organization_id": {
      "$ref": "#/$defs/uuid"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "project_id": {
      "$ref": "#/$defs/nullableUuid"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "action": {
      "type": "string",
      "enum": [
        "SYSTEM_BOOTSTRAP_ADMIN",
        "AUTH_LOGIN_SUCCEEDED",
        "AUTH_LOGIN_FAILED",
        "AUTH_TOKEN_REFRESHED",
        "AUTH_LOGOUT",
        "USER_CREATED",
        "USER_STATUS_CHANGED",
        "USER_PASSWORD_CHANGED",
        "USER_PASSWORD_RESET",
        "USER_UNLOCKED",
        "ROLE_GRANTED",
        "ROLE_REVOKED",
        "PROJECT_CREATED",
        "PROJECT_UPDATED",
        "PROJECT_ARCHIVED",
        "ENDPOINT_POLICY_CREATED",
        "ENDPOINT_POLICY_REVISION_CREATED",
        "ENDPOINT_POLICY_UPDATED",
        "ENDPOINT_POLICY_DISABLED",
        "DATASOURCE_CREATED",
        "DATASOURCE_UPDATED",
        "DATASOURCE_TESTED",
        "DATASOURCE_CREDENTIAL_ROTATED",
        "DATASOURCE_SECRET_STATUS_CHANGED",
        "DATASOURCE_SECRET_ENVELOPE_REWRAPPED",
        "PHYSICAL_ENDPOINT_IDENTITY_BOUND",
        "DATASOURCE_USAGE_GRANTED",
        "DATASOURCE_USAGE_REVOKED",
        "DATASOURCE_DISABLED",
        "DATASOURCE_DELETED",
        "TRANSFER_POLICY_CREATED",
        "TRANSFER_POLICY_SUBMITTED",
        "TRANSFER_POLICY_APPROVED",
        "TRANSFER_POLICY_REJECTED",
        "TRANSFER_POLICY_ACTIVATED",
        "TRANSFER_POLICY_REVOKED",
        "JOB_CREATED",
        "JOB_DRAFT_UPDATED",
        "JOB_VALIDATED",
        "JOB_PREVIEWED",
        "JOB_VERSION_PUBLISHED",
        "JOB_ARCHIVED",
        "EXECUTION_CREATED",
        "TARGET_EXCLUSIVITY_CONFIRMED",
        "TARGET_EXCLUSIVITY_REVOKED",
        "EXECUTION_PREFLIGHT_ACCEPTED",
        "EXECUTION_PREFLIGHT_REJECTED",
        "EXECUTION_CANCEL_REQUESTED",
        "EXECUTION_REMEDIATION_SUBMITTED",
        "RECOVERY_PROBE_CREATED",
        "RECOVERY_PROBE_STARTED",
        "RECOVERY_PROBE_COMPLETED",
        "EXECUTION_RECOVERY_VERIFIED",
        "EXECUTION_RECOVERY_REJECTED",
        "EXECUTION_RERUN_CREATED",
        "EXECUTION_VERIFICATION_STARTED",
        "EXECUTION_VERIFICATION_COMPLETED",
        "EXECUTION_LOG_EXPORTED",
        "AUDIT_ANCHOR_KEY_REGISTERED",
        "AUDIT_ANCHOR_KEY_ROTATED",
        "AUDIT_ANCHOR_KEY_STATUS_CHANGED",
        "AUDIT_CHECKPOINT_ANCHORED",
        "AUDIT_CHECKPOINT_VERIFIED",
        "AUDIT_EXPORTED"
      ]
    },
    "actor": {
      "$ref": "#/$defs/actor"
    },
    "target": {
      "$ref": "#/$defs/target"
    },
    "request": {
      "$ref": "#/$defs/request"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "SUCCEEDED",
        "DENIED",
        "FAILED"
      ]
    },
    "reason_code": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 64,
      "pattern": "^[A-Z0-9_]*$"
    },
    "changes": {
      "$ref": "#/$defs/changes"
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "integrity": {
      "$ref": "#/$defs/integrity"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "TARGET_EXCLUSIVITY_CONFIRMED"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "actor": {
            "properties": {
              "kind": {
                "const": "USER"
              }
            }
          },
          "target": {
            "properties": {
              "type": {
                "const": "EXECUTION"
              },
              "id": {
                "$ref": "#/$defs/uuid"
              }
            }
          },
          "outcome": {
            "const": "SUCCEEDED"
          },
          "metadata": {
            "type": "object",
            "required": [
              "statement_version",
              "responsible_party",
              "confirmed_at",
              "accepted_at",
              "valid_until",
              "target_namespace_id",
              "confirmation_sha256"
            ],
            "properties": {
              "statement_version": {
                "const": "1.0"
              },
              "responsible_party": {
                "type": "string",
                "enum": [
                  "OPERATOR",
                  "DBA"
                ]
              },
              "confirmed_at": {
                "type": "string",
                "format": "date-time"
              },
              "accepted_at": {
                "type": "string",
                "format": "date-time"
              },
              "valid_until": {
                "type": "string",
                "format": "date-time"
              },
              "target_namespace_id": {
                "$ref": "#/$defs/uuid"
              },
              "confirmation_sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "TARGET_EXCLUSIVITY_REVOKED"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "actor": {
            "properties": {
              "kind": {
                "const": "USER"
              }
            }
          },
          "target": {
            "properties": {
              "type": {
                "const": "EXECUTION"
              },
              "id": {
                "$ref": "#/$defs/uuid"
              }
            }
          },
          "outcome": {
            "const": "SUCCEEDED"
          },
          "metadata": {
            "type": "object",
            "required": [
              "statement_version",
              "responsible_party",
              "reported_at",
              "revoked_at",
              "reason",
              "target_namespace_id",
              "confirmation_sha256"
            ],
            "properties": {
              "statement_version": {
                "const": "1.0"
              },
              "responsible_party": {
                "type": "string",
                "enum": [
                  "OPERATOR",
                  "DBA"
                ]
              },
              "reported_at": {
                "type": "string",
                "format": "date-time"
              },
              "revoked_at": {
                "type": "string",
                "format": "date-time"
              },
              "reason": {
                "type": "string",
                "enum": [
                  "OPERATOR_REVOKED",
                  "DBA_REVOKED",
                  "EXTERNAL_DML_DDL_REPORTED",
                  "CHANGE_FREEZE_BROKEN"
                ]
              },
              "target_namespace_id": {
                "$ref": "#/$defs/uuid"
              },
              "confirmation_sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "nullableUuid": {
      "oneOf": [
        {
          "$ref": "#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableHash": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "user_id",
        "display_name"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "USER",
            "SYSTEM"
          ]
        },
        "user_id": {
          "$ref": "#/$defs/nullableUuid"
        },
        "display_name": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "USER"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "user_id": {
                "$ref": "#/$defs/uuid"
              },
              "display_name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            }
          },
          "else": {
            "properties": {
              "user_id": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "name"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "AUTH_SESSION",
            "USER",
            "ROLE_ASSIGNMENT",
            "PROJECT",
            "ENDPOINT_POLICY",
            "ENDPOINT_POLICY_REVISION",
            "DATASOURCE",
            "PHYSICAL_ENDPOINT_IDENTITY",
            "CREDENTIAL_SECRET",
            "CREDENTIAL_SECRET_ENVELOPE",
            "DATASOURCE_USAGE_GRANT",
            "TRANSFER_POLICY",
            "SYNC_JOB",
            "JOB_VERSION",
            "EXECUTION",
            "TARGET_NAMESPACE",
            "RECOVERY_GATE",
            "RECOVERY_PROBE",
            "AUDIT_ANCHOR_KEY_VERSION",
            "AUDIT_CHECKPOINT",
            "AUDIT_EXPORT"
          ]
        },
        "id": {
          "$ref": "#/$defs/nullableUuid"
        },
        "name": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "source_ip",
        "user_agent"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "format": "uuid"
        },
        "source_ip": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 45
        },
        "user_agent": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512
        }
      }
    },
    "changes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "before_hash",
        "after_hash",
        "changed_fields"
      ],
      "properties": {
        "before_hash": {
          "$ref": "#/$defs/nullableHash"
        },
        "after_hash": {
          "$ref": "#/$defs/nullableHash"
        },
        "changed_fields": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.]{0,127}$"
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string",
            "maxLength": 500
          },
          {
            "type": "integer"
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          },
          {
            "type": "null"
          },
          {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "string",
              "maxLength": 128
            }
          }
        ]
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "description": "event_hash = SHA-256(UTF8(\"DXAUDITv1\\n\" + lowercase organization UUID + \"\\n\" + sequence base10 + \"\\n\" + lowercase previous hash or 64 zeroes + \"\\n\") || RFC8785(event object after removing integrity.event_hash)); integrity.previous_hash 必须与前像一致，末尾无 LF。",
      "required": [
        "algorithm",
        "canonicalization",
        "chain_scope",
        "previous_hash",
        "event_hash"
      ],
      "properties": {
        "algorithm": {
          "const": "SHA-256"
        },
        "canonicalization": {
          "const": "RFC8785"
        },
        "chain_scope": {
          "const": "ORGANIZATION_SEQUENCE"
        },
        "previous_hash": {
          "$ref": "#/$defs/nullableHash"
        },
        "event_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "对移除本字段后的完整 AuditEvent 按 integrity.description 计算，避免自引用。"
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datax-enterprise-studio.local/schemas/windows-e4-preflight.v1.schema.json",
  "title": "DataX Enterprise Studio Windows E4 Harness Preflight V1",
  "description": "受保护自托管 Windows E4 harness 的本机前置观察记录。它只能表达本机前置条件是否就绪，固定不表达 E4 PASS、干净基线证明或公开发布批准。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "local_preflight_result",
    "e4_result",
    "release_approved",
    "captured_at",
    "release_candidate",
    "commit_sha",
    "harness_version",
    "baseline",
    "runner",
    "windows",
    "docker",
    "candidate",
    "product_state_absent",
    "checks",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "artifact_kind": {
      "const": "WINDOWS_E4_HARNESS_PREFLIGHT"
    },
    "local_preflight_result": {
      "enum": [
        "READY",
        "BLOCKED"
      ]
    },
    "e4_result": {
      "const": "NOT_RUN"
    },
    "release_approved": {
      "const": false
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "release_candidate": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "commit_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "harness_version": {
      "const": "windows-e4-preflight/v1"
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline_id",
        "independently_verified"
      ],
      "properties": {
        "baseline_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "independently_verified": {
          "const": false,
          "description": "本脚本不会把调用方提供的基线 ID 变成可信 golden-image 证明。"
        }
      }
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runner_id",
        "self_hosted_registration_verified"
      ],
      "properties": {
        "runner_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "self_hosted_registration_verified": {
          "const": false,
          "description": "GitHub runner 注册、隔离组和审批必须由外部受保护控制面另行证明。"
        }
      }
    },
    "windows": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edition",
        "product_type",
        "build",
        "architecture",
        "secure_boot_enabled",
        "virtualization_firmware_enabled",
        "hypervisor_present"
      ],
      "properties": {
        "edition": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "product_type": {
          "enum": [
            "CLIENT",
            "SERVER_OR_OTHER",
            "UNKNOWN"
          ]
        },
        "build": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "architecture": {
          "enum": [
            "X86_64",
            "OTHER"
          ]
        },
        "secure_boot_enabled": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "virtualization_firmware_enabled": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "hypervisor_present": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "docker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ambient_context_absent",
        "wsl_default_version",
        "wsl_status_available",
        "desktop_install_detected",
        "engine_available",
        "server_os",
        "server_architecture",
        "compose_version"
      ],
      "properties": {
        "ambient_context_absent": {
          "type": "boolean"
        },
        "wsl_default_version": {
          "type": [
            "integer",
            "null"
          ]
        },
        "wsl_status_available": {
          "type": "boolean"
        },
        "desktop_install_detected": {
          "type": "boolean"
        },
        "engine_available": {
          "type": "boolean"
        },
        "server_os": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "server_architecture": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "compose_version": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_signer_certificate_der_sha256",
        "setup",
        "launcher"
      ],
      "properties": {
        "expected_signer_certificate_der_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "setup": {
          "$ref": "#/$defs/candidateArtifact"
        },
        "launcher": {
          "$ref": "#/$defs/candidateArtifact"
        }
      }
    },
    "product_state_absent": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "仅表示固定产品目录和已标记 Docker volume 的本机观察，不等同于 clean VM 证明。"
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "candidateArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file_name",
        "sha256",
        "expected_sha256",
        "hash_matches",
        "authenticode_status",
        "signer_certificate_der_sha256",
        "signer_matches",
        "timestamp_present"
      ],
      "properties": {
        "file_name": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "expected_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "hash_matches": {
          "type": "boolean"
        },
        "authenticode_status": {
          "enum": [
            "VALID",
            "INVALID",
            "UNAVAILABLE"
          ]
        },
        "signer_certificate_der_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "signer_matches": {
          "type": "boolean"
        },
        "timestamp_present": {
          "type": "boolean"
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_id",
        "result",
        "detail"
      ],
      "properties": {
        "check_id": {
          "enum": [
            "WIN11_X64_CLIENT",
            "VIRTUALIZATION",
            "WSL2_DEFAULT",
            "DOCKER_AMBIENT_CONTEXT",
            "DOCKER_DESKTOP_LINUX_AMD64",
            "DOCKER_COMPOSE_V2",
            "CANDIDATE_HASHES",
            "CANDIDATE_SIGNATURES",
            "PRODUCT_STATE_ABSENT"
          ]
        },
        "result": {
          "enum": [
            "PASS",
            "BLOCKED"
          ]
        },
        "detail": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "local_preflight_result": {
            "const": "READY"
          }
        },
        "required": [
          "local_preflight_result"
        ]
      },
      "then": {
        "properties": {
          "windows": {
            "properties": {
              "edition": {
                "const": "Windows 11"
              },
              "product_type": {
                "const": "CLIENT"
              },
              "architecture": {
                "const": "X86_64"
              },
              "virtualization_firmware_enabled": {
                "const": true
              }
            }
          },
          "docker": {
            "properties": {
              "ambient_context_absent": {
                "const": true
              },
              "wsl_default_version": {
                "const": 2
              },
              "wsl_status_available": {
                "const": true
              },
              "desktop_install_detected": {
                "const": true
              },
              "engine_available": {
                "const": true
              },
              "server_os": {
                "const": "linux"
              },
              "server_architecture": {
                "const": "amd64"
              }
            }
          },
          "product_state_absent": {
            "const": true
        }
        },
        "allOf": [
          {
            "not": {
              "properties": {
                "checks": {
                  "contains": {
                    "properties": {
                      "result": {
                        "const": "BLOCKED"
                      }
                    },
                    "required": [
                      "result"
                    ]
                  }
                }
              },
              "required": [
                "checks"
              ]
            }
          }
        ]
      }
    }
  ]
}

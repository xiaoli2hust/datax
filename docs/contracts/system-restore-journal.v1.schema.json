{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datax-enterprise-studio.local/schemas/system-restore-journal.v1.schema.json",
  "title": "DataX Enterprise Studio Restore Staging Journal V1",
  "description": "由 DATA 与 SECRETS 两把恢复秘密共同认证的内部 staging journal。STAGED_COMMIT_BLOCKED 不是系统恢复成功。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "journal_id",
    "operation",
    "state",
    "created_at",
    "updated_at",
    "staging_root",
    "data_package",
    "secrets_package",
    "expected",
    "events",
    "authentication"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "journal_id": {
      "$ref": "#/$defs/backupId"
    },
    "operation": {
      "const": "RESTORE_STAGE_PAIR"
    },
    "state": {
      "$ref": "#/$defs/state"
    },
    "created_at": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "updated_at": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "staging_root": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "data_package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "size",
        "sha256",
        "backup_id",
        "kdf_salt_hex"
      ],
      "properties": {
        "size": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "backup_id": {
          "$ref": "#/$defs/backupId"
        },
        "kdf_salt_hex": {
          "$ref": "#/$defs/kdfSalt"
        }
      }
    },
    "secrets_package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "size",
        "sha256",
        "backup_id",
        "related_data_backup_id",
        "kdf_salt_hex"
      ],
      "properties": {
        "size": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "backup_id": {
          "$ref": "#/$defs/backupId"
        },
        "related_data_backup_id": {
          "$ref": "#/$defs/backupId"
        },
        "kdf_salt_hex": {
          "$ref": "#/$defs/kdfSalt"
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_version",
        "migration_revision",
        "release_manifest_sha256",
        "installation_id"
      ],
      "properties": {
        "product_version": {
          "type": "string",
          "pattern": "^[0-9A-Za-z][0-9A-Za-z.+-]{0,63}$"
        },
        "migration_revision": {
          "type": "string",
          "pattern": "^[0-9a-z][0-9a-z_]{0,63}$"
        },
        "release_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "installation_id": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sequence",
          "state",
          "code",
          "recorded_at"
        ],
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "state": {
            "$ref": "#/$defs/state"
          },
          "code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
          },
          "recorded_at": {
            "$ref": "#/$defs/utcTimestamp"
          }
        }
      }
    },
    "authentication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "key_domain",
        "mac_sha256"
      ],
      "properties": {
        "algorithm": {
          "const": "HMAC-SHA256"
        },
        "key_domain": {
          "const": "DXES-RESTORE-JOURNAL-HMAC-v1"
        },
        "mac_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "backupId": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "kdfSalt": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "state": {
      "enum": [
        "INITIALIZED",
        "DATA_STAGED",
        "SECRETS_STAGED",
        "STAGED_COMMIT_BLOCKED",
        "FAILED",
        "CLEANED"
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datax-enterprise-studio.local/schemas/acceptance-manifest.v1.schema.json",
  "title": "DataX Enterprise Studio Acceptance Manifest V1",
  "description": "候选版本发布门禁的机器可读证据清单。requirement_priority 使用 V1-MUST/POST-V1；defect_severity 使用 P0/P1/P2/P3，二者不得混用。gate_result=PASS 时拒绝任何 P0/P1，状态为 ACCEPTED 也不能绕过。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_candidate",
    "commit_sha",
    "generated_at",
    "requirements_catalog_sha256",
    "environment_manifest_sha256",
    "coverage",
    "gate_result",
    "entries",
    "defects",
    "known_limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "release_candidate": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "commit_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "requirements_catalog_sha256": {
      "$ref": "#/$defs/sha256",
      "description": "CI 输入的规范化需求目录 SHA-256；目录至少包含 requirement_id、requirement_priority、精确 test_id 与 minimum_evidence_level。"
    },
    "environment_manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "coverage": {
      "$ref": "#/$defs/coverage"
    },
    "gate_result": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED"
      ]
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "defects": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/defect"
      }
    },
    "known_limitations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "description": "由独立 CI validator 对需求目录与 entries 的 requirement_id/priority/test_id/minimum_evidence_level 元组做精确比对后生成；JSON Schema 只校验形状和 PASS 时的空缺口约束。",
      "required": [
        "expected_v1_must_count",
        "covered_v1_must_count",
        "catalog_exact_match",
        "missing_requirement_ids",
        "duplicate_requirement_test_pairs"
      ],
      "properties": {
        "expected_v1_must_count": {
          "type": "integer",
          "minimum": 1
        },
        "covered_v1_must_count": {
          "type": "integer",
          "minimum": 0
        },
        "catalog_exact_match": {
          "type": "boolean",
          "description": "独立 CI validator 在 catalog hash 有效、expected=covered，且 entries 的 V1-MUST requirement_id/priority/test_id/minimum_evidence_level 元组精确等于 catalog 时写 true。"
        },
        "missing_requirement_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/requirementId"
          }
        },
        "duplicate_requirement_test_pairs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/requirementTestPair"
          }
        }
      }
    },
    "requirementId": {
      "type": "string",
      "pattern": "^(PRD-(FR|BR)-[A-Z0-9-]+|NFR-[A-Z0-9-]+|ACC-PRD-[0-9]{3})$"
    },
    "testId": {
      "type": "string",
      "pattern": "^(UT|CT|IT|E2E|UI|SEC|PERF|REC|OPS)-[A-Z0-9-]+$"
    },
    "requirementTestPair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_id",
        "test_id"
      ],
      "properties": {
        "requirement_id": {
          "$ref": "#/$defs/requirementId"
        },
        "test_id": {
          "$ref": "#/$defs/testId"
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_id",
        "requirement_priority",
        "test_id",
        "result",
        "minimum_evidence_level",
        "evidence_level",
        "oracle",
        "evidence",
        "executed_at",
        "environment_id"
      ],
      "properties": {
        "requirement_id": {
          "$ref": "#/$defs/requirementId"
        },
        "requirement_priority": {
          "type": "string",
          "enum": [
            "V1-MUST",
            "POST-V1"
          ]
        },
        "test_id": {
          "$ref": "#/$defs/testId"
        },
        "result": {
          "type": "string",
          "enum": [
            "PASS",
            "FAIL",
            "BLOCKED",
            "NOT_RUN"
          ]
        },
        "minimum_evidence_level": {
          "type": "string",
          "description": "由权威需求 catalog 固定，独立 CI validator 必须逐项比对；客户端或测试运行器不得自行降低。",
          "enum": [
            "E0",
            "E1",
            "E2",
            "E3",
            "E4"
          ]
        },
        "evidence_level": {
          "type": "string",
          "enum": [
            "E0",
            "E1",
            "E2",
            "E3",
            "E4"
          ]
        },
        "oracle": {
          "description": "仅在独立 oracle 实际启动并产生制品后填写。Oracle 从未启动时必须为 null（Execution.verification_state=NOT_STARTED）；不得用 INCONCLUSIVE 伪装未启动。",
          "oneOf": [
            {
              "$ref": "#/$defs/oracleEvidence"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact"
          }
        },
        "executed_at": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "environment_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "blocked_reason": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1000
        },
        "defect_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "result": {
                "const": "PASS"
              },
              "minimum_evidence_level": {
                "const": "E1"
              }
            },
            "required": [
              "result",
              "minimum_evidence_level"
            ]
          },
          "then": {
            "properties": {
              "evidence_level": {
                "enum": [
                  "E1",
                  "E2",
                  "E3",
                  "E4"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "result": {
                "const": "PASS"
              },
              "minimum_evidence_level": {
                "const": "E2"
              }
            },
            "required": [
              "result",
              "minimum_evidence_level"
            ]
          },
          "then": {
            "properties": {
              "evidence_level": {
                "enum": [
                  "E2",
                  "E3",
                  "E4"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "result": {
                "const": "PASS"
              },
              "minimum_evidence_level": {
                "const": "E3"
              }
            },
            "required": [
              "result",
              "minimum_evidence_level"
            ]
          },
          "then": {
            "properties": {
              "evidence_level": {
                "enum": [
                  "E3",
                  "E4"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "result": {
                "const": "PASS"
              },
              "minimum_evidence_level": {
                "const": "E4"
              }
            },
            "required": [
              "result",
              "minimum_evidence_level"
            ]
          },
          "then": {
            "properties": {
              "evidence_level": {
                "const": "E4"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "result": {
                "const": "PASS"
              }
            },
            "required": [
              "result"
            ]
          },
          "then": {
            "properties": {
              "evidence": {
                "minItems": 1
              },
              "executed_at": {
                "type": "string",
                "format": "date-time"
              },
              "environment_id": {
                "type": "string",
                "minLength": 1
              },
              "blocked_reason": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "result": {
                "const": "PASS"
              },
              "evidence_level": {
                "enum": [
                  "E3",
                  "E4"
                ]
              }
            },
            "required": [
              "result",
              "evidence_level"
            ]
          },
          "then": {
            "properties": {
              "oracle": {
                "$ref": "#/$defs/passedOracleEvidence"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "result": {
                "const": "FAIL"
              }
            },
            "required": [
              "result"
            ]
          },
          "then": {
            "required": [
              "defect_ids"
            ],
            "properties": {
              "evidence": {
                "minItems": 1
              },
              "executed_at": {
                "type": "string",
                "format": "date-time"
              },
              "environment_id": {
                "type": "string",
                "minLength": 1
              },
              "defect_ids": {
                "minItems": 1
              },
              "blocked_reason": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "result": {
                "const": "BLOCKED"
              }
            },
            "required": [
              "result"
            ]
          },
          "then": {
            "required": [
              "blocked_reason"
            ],
            "properties": {
              "blocked_reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "result": {
                "const": "NOT_RUN"
              }
            },
            "required": [
              "result"
            ]
          },
          "then": {
            "properties": {
              "oracle": {
                "type": "null"
              },
              "evidence": {
                "maxItems": 0
              },
              "executed_at": {
                "type": "null"
              },
              "environment_id": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "oracleEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "result",
        "artifact"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "result": {
          "type": "string",
          "description": "INCONCLUSIVE 仅表示 oracle 已启动但无法形成结论；Oracle 未启动不创建 oracleEvidence。",
          "enum": [
            "PASSED",
            "FAILED",
            "INCONCLUSIVE"
          ]
        },
        "artifact": {
          "$ref": "#/$defs/artifact"
        }
      }
    },
    "passedOracleEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "result",
        "artifact"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "result": {
          "const": "PASSED"
        },
        "artifact": {
          "$ref": "#/$defs/artifact"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9_./-]+$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "defect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "defect_id",
        "defect_severity",
        "status"
      ],
      "properties": {
        "defect_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "defect_severity": {
          "type": "string",
          "enum": [
            "P0",
            "P1",
            "P2",
            "P3"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "OPEN",
            "FIXED",
            "ACCEPTED"
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "gate_result": {
            "const": "PASS"
          }
        },
        "required": [
          "gate_result"
        ]
      },
      "then": {
        "properties": {
          "entries": {
            "not": {
              "contains": {
                "properties": {
                  "requirement_priority": {
                    "const": "V1-MUST"
                  },
                  "result": {
                    "enum": [
                      "FAIL",
                      "BLOCKED",
                      "NOT_RUN"
                    ]
                  }
                },
                "required": [
                  "requirement_priority",
                  "result"
                ]
              }
            }
          },
          "defects": {
            "not": {
              "contains": {
                "properties": {
                  "defect_severity": {
                    "enum": [
                      "P0",
                      "P1"
                    ]
                  }
                },
                "required": [
                  "defect_severity"
                ]
              }
            }
          },
          "coverage": {
            "properties": {
              "catalog_exact_match": {
                "const": true
              },
              "missing_requirement_ids": {
                "maxItems": 0
              },
              "duplicate_requirement_test_pairs": {
                "maxItems": 0
              }
            }
          }
        }
      }
    }
  ]
}
